FROM python:3.12-slim

WORKDIR /app

# Install PulseAudio, ALSA, espeak-ng, and audio utilities for physical speaker sound
RUN apt-get update && apt-get install -y --no-install-recommends \
    pulseaudio-utils \
    alsa-utils \
    espeak-ng \
    speech-dispatcher \
    speech-dispatcher-espeak-ng \
    && rm -rf /var/lib/apt/lists/*

COPY sirena_service.py /app/

# Run unprivileged. uid 1000 matches the host user that owns the PulseAudio socket;
# compose adds the audio group for /dev/snd.
RUN useradd --uid 1000 --create-home --shell /usr/sbin/nologin sari
USER sari

EXPOSE 5000

CMD ["python3", "sirena_service.py"]
