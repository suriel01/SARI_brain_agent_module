FROM python:3.12-slim

WORKDIR /app

# Install PulseAudio, ALSA, espeak-ng, and audio utilities for physical speaker sound
RUN apt-get update && apt-get install -y --no-install-recommends \
    pulseaudio-utils \
    alsa-utils \
    espeak-ng \
    speech-dispatcher \
    speech-dispatcher-espeak-ng \
    && rm -rf /var/lib/apt/lists/*

COPY sirena_service.py /app/

EXPOSE 5000

CMD ["python3", "sirena_service.py"]
