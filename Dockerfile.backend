FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements (pinned)
COPY backend/requirements.txt backend/requirements-dev.txt /tmp/req/
RUN pip install --no-cache-dir -r /tmp/req/requirements-dev.txt

# Copy project files
COPY backend/app /app/app
COPY backend/alembic.ini /app/alembic.ini
COPY backend/migrations /app/migrations

# Run unprivileged (no write access to the application code)
RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin sari
USER sari

EXPOSE 7000

ENV PORT=7000
ENV OLLAMA_URL=http://host.docker.internal:11434/api/chat
ENV SIRENA_SERVICE_URL=http://sari-sirena:5000

# API only, two workers (state, limiters and realtime events are shared through PostgreSQL).
# Background work runs in `python -m app.worker` (the sari-worker service).
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7000", "--workers", "2"]
