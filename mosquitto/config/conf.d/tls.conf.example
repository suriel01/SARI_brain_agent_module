# MQTT over TLS on 8883. Rename to tls.conf (only *.conf files are loaded) after running
#   scripts/gen-mqtt-certs.sh <broker-hostname-or-ip> [...]
# Mosquitto refuses to start when a listener references missing certificate files,
# which is why this listener is not enabled by default.
listener 8883 0.0.0.0
cafile /mosquitto/certs/ca.crt
certfile /mosquitto/certs/server.crt
keyfile /mosquitto/certs/server.key
tls_version tlsv1.2
