define flow activate siren
  user ask activate siren
  $res = execute execute_activar_sirena
  bot respond "🚨 Entendido. He activado la sirena/alarma física de emergencia por 30 segundos. El sistema se encuentra en alerta máxima."

define flow deactivate siren
  user ask deactivate siren
  $res = execute execute_desactivar_sirena
  bot respond "🔊 Entendido. La sirena/alarma física ha sido desactivada. El sistema vuelve a su estado de monitoreo normal."

define flow close gates
  user ask close gates
  $res = execute execute_cerrar_accesos
  bot respond "🔒 Entendido. Todos los accesos perimetrales han sido bloqueados con éxito."

define flow express greeting
  user express greeting
  bot respond "¡Hola! Soy SARI, tu Sistema Autónomo de Respuesta Inmediata. ¿En qué puedo ayudarte hoy con la seguridad perimetral o el control de hardware?"

define flow ask identity
  user ask identity
  bot respond "Soy SARI (Sistema Autónomo de Respuesta Inmediata). Mi función es monitorear el perímetro, registrar alertas de seguridad, consultar el historial táctico y controlar los dispositivos físicos como la sirena/alarma y los accesos."
